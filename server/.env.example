# ——— База данных ———
# Локально: обе строки одинаковые. В Supabase: DATABASE_URL = Session pooler, DIRECT_URL = прямое подключение.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/credit_tracker?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/credit_tracker?schema=public"

# ——— JWT ———
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ——— Сервер ———
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# ——— Web Push (сгенерировать: npm run vapid:gen) ———
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
