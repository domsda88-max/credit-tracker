# Test-only environment. Copy to .env.test locally. Never point at production.
NODE_ENV=test
PORT=4000
DATABASE_URL="postgresql://credit_test:credit_test_password@localhost:5433/credit_tracker_test?schema=public"
DIRECT_URL="postgresql://credit_test:credit_test_password@localhost:5433/credit_tracker_test?schema=public"

# Test JWT only. Do not reuse production secret.
JWT_SECRET="test-only-not-production"
JWT_EXPIRES_IN="7d"

CLIENT_ORIGIN="http://localhost:5173"

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:test@example.com"

# Optional. Add only after real values are obtained, with a separate real SendGrid etc.
# Better avoid test pushes if you do not have isolated providers.
